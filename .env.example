# Discord bot token (from Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord user ID (enable Developer Mode → right-click your name → Copy User ID)
DISCORD_USER_ID=your_discord_user_id_here

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database path (Railway persistent volume should be mounted at /data)
DB_PATH=/data/etf_analyzer.db

# Daily report schedule (KST, 24h)
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
